# URL canônica do site publicado (usada em metadata, canonical e sitemap)
# Exemplo: https://metodo-verao-lucrativo.vercel.app
NEXT_PUBLIC_SITE_URL=https://seu-dominio.vercel.app

# Meta Pixel (opcional)
# ID numérico do pixel criado no Gerenciador de Eventos do Meta Business Suite.
# Deixe em branco para desativar o rastreamento sem quebrar a página.
NEXT_PUBLIC_META_PIXEL_ID=

# Google Analytics 4 (opcional)
# ID de medição no formato G-XXXXXXXXXX, encontrado no Google Analytics.
# Deixe em branco para desativar o rastreamento sem quebrar a página.
NEXT_PUBLIC_GA_ID=
